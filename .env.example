# ==== Chen Shop — environment variables ====
# Copy to .env.local for local runs. On Vercel, add these in
# Project → Settings → Environment Variables (Production + Preview).

# Neon Postgres connection string (Vercel → Storage → Neon fills this in automatically).
# Leave empty locally to use the built-in local database in .local-data/.
DATABASE_URL=

# Vercel Blob token for product photo uploads (Vercel → Storage → Blob fills this in automatically).
# Leave empty locally: uploads are saved to .local-data/uploads.
BLOB_READ_WRITE_TOKEN=

# Admin login. Password: at least 8 characters. Secret: a long random string (≥ 32 characters).
# Local test values (only used when these are empty and the app is NOT on Vercel):
#   ADMIN_PASSWORD=chenshop-dev
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: your public domain, used for SEO/sitemap (e.g. https://chenshop.vn).
NEXT_PUBLIC_SITE_URL=

# Optional (paused): Google Sheets sync of customer requests. See integrations/chen-sheets.gs.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
